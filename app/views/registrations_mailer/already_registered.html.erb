<% content_for :preheader, "Someone tried to sign up with your email address. Sign in instead." %>

<%= email_heading "You already have an account" %>

<%= email_paragraph do %>
  Someone tried to sign up with <strong><%= @user.email_address %></strong>, but there's already a Mindboop account
  for that address. Sign in to pick up where you left off.
<% end %>

<%= email_button "Sign in", root_url %>

<%= email_note do %>
  Don't remember your password? Use "Forgot password?" on the sign-in page.
<% end %>

<%= email_note do %>
  If this wasn't you, you can ignore this email.
<% end %>
