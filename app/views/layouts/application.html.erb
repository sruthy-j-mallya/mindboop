<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mindboop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mindboop">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Applies the saved theme (or the OS preference) before first paint. useApplyTheme.ts handles later changes. %>
    <%= javascript_tag do %>
      (() => {
        const theme = <%= raw theme_preference.to_json %>;
        const isDark = theme === "system" ? matchMedia("(prefers-color-scheme: dark)").matches : theme === "dark";
        document.documentElement.classList.toggle("dark", isDark);
      })();
    <% end %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "application.tsx" %>
  </head>

  <body>
    <div id="root"></div>
    <%= yield %>
  </body>
</html>
