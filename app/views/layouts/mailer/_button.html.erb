<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 8px 0 24px; border-collapse: separate;">
  <tr>
    <td align="center" bgcolor="<%= email_color(:purple) %>" style="border-radius: 8px; background-color: <%= email_color(:purple) %>;">
      <%= link_to text, url, target: "_blank", rel: "noopener",
            style: "display: inline-block; padding: 12px 28px; border: 1px solid #{email_color(:purple)}; border-radius: 8px; " \
                   "font-family: #{email_font_family}; font-size: 16px; line-height: 24px; font-weight: 600; " \
                   "color: #{email_color(:on_purple)}; text-decoration: none;" %>
    </td>
  </tr>
</table>
