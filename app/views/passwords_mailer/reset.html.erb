<% reset_url = edit_password_url(@user.password_reset_token) %>
<% expires_in = distance_of_time_in_words(0, @user.password_reset_token_expires_in) %>
<% content_for :preheader, "Use this link to choose a new password. It expires in #{expires_in}." %>

<%= email_heading "Reset your password" %>

<%= email_paragraph do %>
  We got a request to reset the password for your Mindboop account. Choose a new one with the button below.
<% end %>

<%= email_button "Reset password", reset_url %>

<%= email_note do %>
  This link expires in <%= expires_in %>. If you didn't ask to reset your password, you can ignore this email; your
  password won't change.
<% end %>

<%= email_fallback_link reset_url %>
